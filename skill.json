{
  "name": "ai-sdlc",
  "version": "VERSION_FROM_FILE",
  "description": "AI-native Software Development Lifecycle framework. Three phases, five gates, proof over prose.",
  "homepage": "https://github.com/wico216/ai-sdlc",
  "license": "MIT",
  "authors": ["wico216"],
  "keywords": ["sdlc", "ai-sdlc", "development-lifecycle", "project-management", "ddd"],
  "install": {
